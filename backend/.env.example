PORT=3008
ALLOWED_ORIGIN=https://mycarbook.chainintegrate.it
# Dominio scritto nel messaggio firmato per gli upload (deve coincidere con
# quello del sito).
AUTH_DOMAIN=mycarbook.chainintegrate.it

# API Kubo del nodo IPFS proprio. Preferire un tunnel (WireGuard/SSH) o TLS;
# vedi docs/OPERATIONS.md. IPFS_API_AUTH è l'intestazione Authorization da
# inviare se sul nodo è attivo API.Authorizations (Kubo >= 0.25).
IPFS_API_URL=
IPFS_API_AUTH=

# Reti ammesse per le firme (solo mainnet in produzione).
ALLOWED_CHAIN_IDS=42
# RPC_URL_42=https://rpc.mainnet.lukso.network

# Azioni admin (admin-collection.html): UP owner del contratto e UNA chiave
# controller precisa di quella UP (indirizzo EOA del controller con cui
# firma l'estensione dell'admin). Se uno dei due manca, le azioni admin sono
# disattivate. Aggiornare quando l'ownership del contratto verrà spostata.
ADMIN_UP_ADDRESS=
ADMIN_SIGNER_ADDRESS=

# Nginx in locale: "loopback" (default). Non cambiare senza motivo.
TRUST_PROXY=loopback

# Registro dei CID pinnati dal backend (per il job di pulizia dei pin orfani).
# PIN_LEDGER_PATH=/home/mycarbook/backend/data/pins.jsonl
